NODE_ENV=development
PORT=3000

# Supabase: Project Settings > Database > Connection string (URI)
# Pakai "Session pooler" atau "Direct connection" (port 5432)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# Pisahkan dengan koma. Kosongkan saat development (localhost otomatis diizinkan)
CORS_ORIGINS=

# Rahasia penanda JWT (minimal 32 karakter). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30